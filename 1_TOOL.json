{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output-TOOL.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "showLineNumbers": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "includeFullDirectoryStructure": false
  },
  "include": [
    "HANDOFF-TOOL.md",
    ".cargo/**",
    "src-tauri/.cargo/**",
    "src-tauri/Cargo.toml",
    "src-tauri/tauri.conf.json",
    "src-tauri/capabilities/**",
    "src-tauri/src/**",
    "deploy/cloudflare/auth_worker.js",
    "src/bindings.ts",
    "src/bindings/**",

    "package.json",
    "vite.config.ts",
    "postcss.config.js",
    "tailwind.config.js",
    "index.html",

    "src/App.vue",
    "src/main.ts",
    "src/style.css",
    "src/vite-env.d.ts",
    "src/composables/useTauriWindow.ts",
    "src/store/uiStore.ts",
    "src/locales/**",
    "src/components/layout/Sidebar.vue",
    "src/components/effects/**",
    "src/components/ui/**",
    "src/views/HomeView.vue",
    "src/views/VideoSubtitleView.vue",
    
    "src-tauri/crates/core-models-download/**",
    "src-tauri/crates/core-security/**",
    "src-tauri/crates/shared-contracts/**",
    "src-tauri/crates/core-onnx-infer/**",
    
    "src-tauri/crates/services/service-asr/**",
    "src-tauri/crates/services/service-translation/**",
    "src-tauri/crates/tools/video-subtitle/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "src-tauri/target/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/*.onnx",
      "**/*.gguf",
      "**/*.bin",
      "**/*.pdiparams",
      "**/*.pdmodel",
      "test/fixtures/**",
      "test/outs/**",
      "data/**",
      "**/*.sqlite3*",
      "dist/**",

      "src-tauri/crates/tools/tool-pdf-parse/**",
      "src-tauri/crates/tools/pdf-parse/**",
      "src-tauri/crates/tools/format-converter/**",
      
      "src-tauri/crates/services/service-pdfium/**",
      "src-tauri/crates/services/service-doc-parse/**",
      "src-tauri/crates/services/service-formula/**",
      "src-tauri/crates/services/service-layout/**",
      "src-tauri/crates/services/service-table/**",
      "src-tauri/crates/services/service-ocr/**",
      "src-tauri/crates/services/service-converter/**"
    ]
  }
}
