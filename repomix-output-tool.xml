    #[tokio::test]
    async fn test_service_asr_pure_native() {
        let fixture_audio = PathBuf::from(r"C:\dev\ai-forge\test\fixtures\ASR_英语_餐厅就餐.mp3");
        if !fixture_audio.exists() {
