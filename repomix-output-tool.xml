mod tests {
    use super::*;

    #[tokio::test]
    async fn test_model_manager_hash() {
        let tmp_file = std::env::temp_dir().join("test_model.bin");
        tokio::fs::write(&tmp_file, b"AI-Forge 4-bit Quantized Model Payload").await.unwrap();

