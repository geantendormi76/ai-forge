        std::fs::write(&out_json_path, &json_data).unwrap();

        println!("  💾 纯血 Native JSON 成功物理落盘: {:?}", out_json_path);
        println!("  预览前 3 句识别结果:");
        for seg in res.segments.iter().take(3) {
            println!("     [{:.2}s -> {:.2}s] [{}]: {}", seg.start_sec, seg.end_sec, seg.speaker, seg.text);
        }
    }
