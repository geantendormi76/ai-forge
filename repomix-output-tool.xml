@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    color-scheme: dark;
    --bg: #20292b;
    --panel: rgba(24, 32, 34, 0.78);
    --panel-card: rgba(255, 255, 255, 0.03);
    --panel-card-hover: rgba(255, 255, 255, 0.06);
    --ink: #f5f5f3;
    --muted: #8b999b;
    --quiet: #5b696b;
    --line: rgba(255, 255, 255, 0.08);
    --line-strong: rgba(255, 255, 255, 0.18);
    --white: #f2f2ef;
    --black: #141b1c;
    --zidian-gold: #DCA54C;
    --zidian-purple: #bc05ff;
    --aegis-nav-height: 45px;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
