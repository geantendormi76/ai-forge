<script setup lang="ts">
import { ref, useTemplateRef } from 'vue';
import { useI18n } from 'vue-i18n';
import {
  Film,
  UploadCloud,
  Play,
  CheckCircle2,
  Sliders,
  FileText,
  Sparkles,
  Code2,
  Video,
  Layers,
  Compass
} from 'lucide-vue-next';
import { useUIStore } from '../store/uiStore';
import {
  probeVideo,
  runVideoSubtitle,
  type VideoProbeResult,
  type VideoSubtitleOptions,
  type VideoSubtitleResult,
  type SubtitleSourceKind,
  type SubtitleDisplayMode,
  type SubtitleOutputMode,
  type RoiPresetMode
} from '../bindings/tools/video-subtitle';

const { t, locale } = useI18n();
const ui = useUIStore();

const fileInputRef = useTemplateRef<HTMLInputElement>('fileInputRef');
const currentLang = ref<'zh-CN' | 'en-US'>('zh-CN');
const selectedFilePath = ref<string>('C:\\dev\\ai-forge\\test\\fixtures\\tool-video-subtitle.mp4');
const selectedFileName = ref<string>('tool-video-subtitle.mp4');
const isProcessing = ref<boolean>(false);
const isProbing = ref<boolean>(false);
const probeResult = ref<VideoProbeResult | null>(null);
const subtitleResult = ref<VideoSubtitleResult | null>(null);

// 定制选项响应式绑定
const selectedSourceKind = ref<SubtitleSourceKind>('raw_audio');
const selectedStreamIndex = ref<number>(2);
const selectedRoiMode = ref<RoiPresetMode>('bottom_standard');

const targetLang = ref<string>('Chinese');
const displayMode = ref<SubtitleDisplayMode>('bilingual');
const outputMode = ref<SubtitleOutputMode>('soft_mkv');
const fontSizeMultiplier = ref<number>(1.8);
const showSpeaker = ref<boolean>(false);
const hotwords = ref<string>('');

const toggleLanguage = () => {
  currentLang.value = currentLang.value === 'zh-CN' ? 'en-US' : 'zh-CN';
  locale.value = currentLang.value;
};

const triggerFileSelect = () => {
  fileInputRef.value?.click();
};

const triggerProbe = async (filePath: string) => {
  if (!filePath) return;
  isProbing.value = true;
  probeResult.value = null;

  try {
    const res = await probeVideo(filePath);
    probeResult.value = res;
    selectedSourceKind.value = res.recommended_mode;
    if (res.soft_tracks.length > 0) {
      selectedStreamIndex.value = res.soft_tracks[0].stream_index;
    }
    const modeLabel = res.recommended_mode === 'embedded_soft_stream' 
      ? '⚡ 内嵌软字幕' 
      : res.recommended_mode === 'burned_hard_sub' 
        ? '🖼️ 画面硬字幕' 
        : '🎙️ 生肉视频';
    ui.弹出提示(`🔍 探针完成：智能推荐【${modeLabel}】路由`, 'info');
  } catch (e: any) {
    console.warn('探针探测异常:', e);
  } finally {
    isProbing.value = false;
  }
};

const handleFileChange = (e: Event) => {
  const input = e.target as HTMLInputElement;
  if (input.files && input.files.length > 0) {
    const file = input.files[0];
    selectedFileName.value = file.name;
    const path = (file as any).path || file.name;
    selectedFilePath.value = path;
    triggerProbe(path);
  }
};

const handleFileDrop = (e: DragEvent) => {
  const files = e.dataTransfer?.files;
  if (files && files.length > 0) {
    const file = files[0];
    selectedFileName.value = file.name;
    const path = (file as any).path || file.name;
    selectedFilePath.value = path;
    triggerProbe(path);
  }
};

const executeSubtitleProcess = async () => {
  if (!selectedFilePath.value) return;
  isProcessing.value = true;
  subtitleResult.value = null;

  const options: VideoSubtitleOptions = {
    video_path: selectedFilePath.value,
    output_dir: null,
    target_lang: targetLang.value,
    display_mode: displayMode.value,
    show_speaker: showSpeaker.value,
    font_size_multiplier: fontSizeMultiplier.value,
    output_mode: outputMode.value,
    hotwords: hotwords.value.trim() ? hotwords.value.trim() : null,
    glossary: null,
    source_kind: selectedSourceKind.value,
    subtitle_stream_index: selectedSourceKind.value === 'embedded_soft_stream' ? selectedStreamIndex.value : null,
    roi_mode: selectedSourceKind.value === 'burned_hard_sub' ? selectedRoiMode.value : null,
    custom_roi: null
  };

  try {
    const res = await runVideoSubtitle(options);
    subtitleResult.value = res;
    ui.弹出提示('🎉 双语字幕转写与压制已全部完成！', 'success');
  } catch (err: any) {
    ui.弹出提示('🚨 字幕流水线执行异常: ' + String(err), 'error');
  } finally {
    isProcessing.value = false;
  }
};

const copyPath = (path: string, label: string) => {
  if (!path) return;
  navigator.clipboard.writeText(path);
  ui.弹出提示(`✅ 已复制 ${label} 产物路径到剪贴板`, 'success');
};

const formatTime = (seconds: number) => {
  const mins = Math.floor(seconds / 60);
  const secs = (seconds % 60).toFixed(2);
  return `${mins.toString().padStart(2, '0')}:${secs.padStart(5, '0')}`;
};
</script>
