import { invoke } from "@tauri-apps/api/core";

/** 视频字幕分类形态：纯生肉音频流 / 内嵌软字幕流 */
export type SubtitleSourceKind = "raw_audio" | "embedded_soft_stream";

/** 内嵌软字幕轨道元数据描述 */
