        let out_dir = PathBuf::from(r"C:\dev\ai-forge\test\outs\service-pdfium");
        let _ = fs::create_dir_all(&out_dir);

        if !pdf_path.exists() {
            return;
        }

        if PdfiumEngine::resolve_dll_path().is_none() {
