// 🛡️ 8K 视觉超分 - 纯血 ONNX GPU 极速流水线 (pipeline.rs)

use crate::processor::ImageProcessor;
use crate::tiling::compute_grid;
use crate::{UpscaleConfig, UpscaleResult};
use core_onnx_infer::OrtInfer;
use image::RgbImage;
use std::path::Path;
use std::time::Instant;

pub struct UpscalePipeline {
    infer: OrtInfer,
}

impl UpscalePipeline {
    pub fn new(model_path: &Path) -> Result<Self, String> {
        let infer = OrtInfer::new(model_path, Some("cuda:0"))
            .map_err(|e| format!("初始化 ONNX 超分引擎失败: {e} ({:?})", model_path))?;
        Ok(Self { infer })
    }

    pub fn run<F>(
        &mut self,
        input_path: &Path,
        output_path: &Path,
        config: &UpscaleConfig,
        progress_cb: Option<F>,
    ) -> Result<UpscaleResult, String>
    where
        F: Fn(usize, usize, &str) + Send + Sync,
    {
        let t0 = Instant::now();

        if let Some(ref cb) = progress_cb {
            cb(0, 100, "正在加载源图像并分离透明通道...");
        }

        // 1. 预处理
        let prep = ImageProcessor::load_and_preprocess(
            input_path,
            config.target_scale,
            config.max_output_side,
        )?;

        let orig_w = prep.orig_w;
        let orig_h = prep.orig_h;
        let target_w = prep.target_w;
        let target_h = prep.target_h;
        let actual_scale = prep.actual_scale;

        // 2. 切块网格计算
        let tiles = compute_grid(orig_w, orig_h, config.tile_size, config.tile_pad);
        let total_tiles = tiles.len();

        // 3. 构建 4x 目标物理画布
        let model_scale = 4u32;
        let mut canvas_4x = RgbImage::new(orig_w * model_scale, orig_h * model_scale);

        // 4. 逐块 GPU 矩阵直推
        for (idx, tile) in tiles.iter().enumerate() {
            if let Some(ref cb) = progress_cb {
                let msg = format!("RTX 显卡超分推理中 ({}/{})", idx + 1, total_tiles);
                cb(idx + 1, total_tiles, &msg);
            }

            let input_tensor = ImageProcessor::crop_to_tensor(&prep.rgb_image, tile);
            let out_tensor = self
                .infer
                .infer_array4(&input_tensor)
                .map_err(|e| format!("ONNX 切块推理失败: {e}"))?;

            ImageProcessor::paste_tile_to_canvas(
                &mut canvas_4x,
                &out_tensor,
                tile,
                model_scale,
            );
        }

        if let Some(ref cb) = progress_cb {
            cb(total_tiles, total_tiles, "正在执行双三次重采样与通道融合...");
        }

        // 5. 缩放与落盘
        ImageProcessor::finalize_and_save(
            canvas_4x,
            prep.alpha_channel,
            target_w,
            target_h,
            output_path,
        )?;

        let elapsed_ms = t0.elapsed().as_millis() as u64;

        Ok(UpscaleResult {
            success: true,
            input_path: input_path.to_string_lossy().to_string(),
            output_path: output_path.to_string_lossy().to_string(),
            original_size: (orig_w, orig_h),
            output_size: (target_w, target_h),
            actual_scale,
            elapsed_ms,
            total_tiles,
        })
    }
}
