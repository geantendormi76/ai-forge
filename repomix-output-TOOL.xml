        let out_md = res.output_path.unwrap();
        let md_content = std::fs::read_to_string(&out_md).unwrap();
        assert!(md_content.contains("| Alice | 100 |"));

        let _ = std::fs::remove_dir_all(temp_dir);
        println!("✅ format-converter 桌面端工具中枢调度与分流交付断言通过！");
    }
