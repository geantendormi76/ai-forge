impl DBPostProcess {
    /// 🛡️ 1:1 对齐官方 PP-OCRv6_det inference.yml 默认黄金参数
    pub fn new(
        thresh: Option<f32>,
        box_thresh: Option<f32>,
        max_candidates: Option<usize>,
        unclip_ratio: Option<f32>,
        use_dilation: Option<bool>,
        score_mode: Option<ScoreMode>,
        box_type: Option<BoxType>,
