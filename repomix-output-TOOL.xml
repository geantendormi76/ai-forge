// 🛡️ 8K 视觉超分 - 极速内存前处理/后处理引擎 (processor.rs)
// 100% 外科手术式直译自 upscale_worker.py

use crate::tiling::TileInfo;
use fast_image_resize::images::{Image as FrImage, ImageRef};
use fast_image_resize::{FilterType, PixelType, ResizeAlg, ResizeOptions, Resizer};
use image::{DynamicImage, GenericImageView, GrayImage, ImageBuffer, Rgb, RgbImage, Rgba, RgbaImage};
use ndarray::Array4;
use std::num::NonZeroU32;
use std::path::Path;

#[derive(Debug, Clone)]
pub struct PreprocessedImage {
    pub rgb_image: RgbImage,
    pub alpha_channel: Option<GrayImage>,
    pub orig_w: u32,
    pub orig_h: u32,
    pub target_w: u32,
    pub target_h: u32,
    pub actual_scale: f32,
}

pub struct ImageProcessor;

impl ImageProcessor {
    pub fn load_and_preprocess(
        input_path: &Path,
        req_scale: f32,
        max_output_side: u32,
    ) -> Result<PreprocessedImage, String> {
        let dyn_img = image::open(input_path)
            .map_err(|e| format!("打开图像文件失败: {e} ({:?})", input_path))?;

        let (orig_w, orig_h) = dyn_img.dimensions();
        if orig_w == 0 || orig_h == 0 {
            return Err("图像尺寸为 0，无法进行超分处理".to_string());
        }

        let (rgb_image, alpha_channel) = match dyn_img {
            DynamicImage::ImageRgba8(rgba) => {
                let mut rgb = RgbImage::new(orig_w, orig_h);
                let mut alpha = GrayImage::new(orig_w, orig_h);
                let mut has_transparency = false;

                for y in 0..orig_h {
                    for x in 0..orig_w {
                        let p = rgba.get_pixel(x, y);
                        rgb.put_pixel(x, y, Rgb([p[0], p[1], p[2]]));
                        alpha.put_pixel(x, y, image::Luma([p[3]]));
                        if p[3] < 255 {
                            has_transparency = true;
                        }
                    }
                }

                (rgb, if has_transparency { Some(alpha) } else { None })
            }
            _ => (dyn_img.to_rgb8(), None),
        };

        let max_in_side = orig_w.max(orig_h);
        let mut actual_scale = req_scale;
        if (max_in_side as f32 * req_scale) > max_output_side as f32 {
            actual_scale = (max_output_side as f32 / max_in_side as f32).max(1.0);
        }

        let target_w = ((orig_w as f32 * actual_scale).round() as u32).max(1);
        let target_h = ((orig_h as f32 * actual_scale).round() as u32).max(1);

        Ok(PreprocessedImage {
            rgb_image,
            alpha_channel,
            orig_w,
            orig_h,
            target_w,
            target_h,
            actual_scale,
        })
    }

    /// ⚡ 高速向量化切块转 Array4<f32>: [1, 3, crop_h, crop_w], 范围 [0.0, 1.0]
    pub fn crop_to_tensor(rgb_image: &RgbImage, tile: &TileInfo) -> Array4<f32> {
        let (crop_x, crop_y, crop_w, crop_h) = tile.crop_rect();
        let plane_size = (crop_w * crop_h) as usize;
        let mut data = Vec::with_capacity(3 * plane_size);

        let raw_pixels = rgb_image.as_raw();
        let img_w = rgb_image.width() as usize;

        // Planar NCHW: Channel R
        for dy in 0..crop_h as usize {
            let py = crop_y as usize + dy;
            let row_start = (py * img_w + crop_x as usize) * 3;
            for dx in 0..crop_w as usize {
                data.push(raw_pixels[row_start + dx * 3] as f32 / 255.0);
            }
        }
        // Channel G
        for dy in 0..crop_h as usize {
            let py = crop_y as usize + dy;
            let row_start = (py * img_w + crop_x as usize) * 3;
            for dx in 0..crop_w as usize {
                data.push(raw_pixels[row_start + dx * 3 + 1] as f32 / 255.0);
            }
        }
        // Channel B
        for dy in 0..crop_h as usize {
            let py = crop_y as usize + dy;
            let row_start = (py * img_w + crop_x as usize) * 3;
            for dx in 0..crop_w as usize {
                data.push(raw_pixels[row_start + dx * 3 + 2] as f32 / 255.0);
            }
        }

        Array4::from_shape_vec((1, 3, crop_h as usize, crop_w as usize), data)
            .unwrap_or_else(|_| Array4::zeros((1, 3, crop_h as usize, crop_w as usize)))
    }

    /// ⚡ 行级连续内存极速贴图 (剔除重叠 Padding)
    pub fn paste_tile_to_canvas(
        canvas_4x: &mut RgbImage,
        out_tensor: &Array4<f32>,
        tile: &TileInfo,
        model_scale: u32,
    ) {
        let (_, _, crop_w, crop_h) = tile.crop_rect();
        let out_w = (crop_w * model_scale) as usize;
        let out_h = (crop_h * model_scale) as usize;
        let out_plane_size = out_w * out_h;

        let tensor_slice = if let Some(slice) = out_tensor.as_slice() {
            slice
        } else {
            return;
        };

        let r_plane = &tensor_slice[0..out_plane_size];
        let g_plane = &tensor_slice[out_plane_size..2 * out_plane_size];
        let b_plane = &tensor_slice[2 * out_plane_size..3 * out_plane_size];

        let (valid_x, valid_y, valid_w, valid_h) = tile.valid_scaled_rect(model_scale);
        let (paste_x, paste_y) = tile.canvas_paste_pos(model_scale);

        let canvas_w = canvas_4x.width() as usize;
        let canvas_raw: &mut [u8] = canvas_4x.as_mut();

        for dy in 0..valid_h as usize {
            let src_y = valid_y as usize + dy;
            let src_row_start = src_y * out_w + valid_x as usize;

            let dst_y = paste_y as usize + dy;
            let dst_row_start = (dst_y * canvas_w + paste_x as usize) * 3;

            for dx in 0..valid_w as usize {
                let r = (r_plane[src_row_start + dx].clamp(0.0, 1.0) * 255.0).round() as u8;
                let g = (g_plane[src_row_start + dx].clamp(0.0, 1.0) * 255.0).round() as u8;
                let b = (b_plane[src_row_start + dx].clamp(0.0, 1.0) * 255.0).round() as u8;

                let dst_idx = dst_row_start + dx * 3;
                canvas_raw[dst_idx] = r;
                canvas_raw[dst_idx + 1] = g;
                canvas_raw[dst_idx + 2] = b;
            }
        }
    }

    pub fn resize_rgb(src: &RgbImage, dst_w: u32, dst_h: u32) -> Result<RgbImage, String> {
        if src.width() == dst_w && src.height() == dst_h {
            return Ok(src.clone());
        }

        let width = NonZeroU32::new(src.width()).ok_or("输入图像宽度为0")?;
        let height = NonZeroU32::new(src.height()).ok_or("输入图像高度为0")?;
        let dst_width = NonZeroU32::new(dst_w).ok_or("目标图像宽度为0")?;
        let dst_height = NonZeroU32::new(dst_h).ok_or("目标图像高度为0")?;

        let src_view = ImageRef::new(width.get(), height.get(), src.as_raw(), PixelType::U8x3)
            .map_err(|e| format!("创建源图像视图失败: {e}"))?;

        let mut dst_view = FrImage::new(dst_width.get(), dst_height.get(), PixelType::U8x3);
        let mut resizer = Resizer::new();
        let options = ResizeOptions::new().resize_alg(ResizeAlg::Convolution(FilterType::CatmullRom));

        resizer
            .resize(&src_view, &mut dst_view, &options)
            .map_err(|e| format!("Bicubic 重采样失败: {e}"))?;

        ImageBuffer::from_raw(dst_w, dst_h, dst_view.into_vec())
            .ok_or_else(|| "构造 RgbImage 输出缓冲区失败".to_string())
    }

    pub fn resize_alpha(src: &GrayImage, dst_w: u32, dst_h: u32) -> Result<GrayImage, String> {
        if src.width() == dst_w && src.height() == dst_h {
            return Ok(src.clone());
        }

        let width = NonZeroU32::new(src.width()).ok_or("输入通道宽度为0")?;
        let height = NonZeroU32::new(src.height()).ok_or("输入通道高度为0")?;
        let dst_width = NonZeroU32::new(dst_w).ok_or("目标通道宽度为0")?;
        let dst_height = NonZeroU32::new(dst_h).ok_or("目标通道高度为0")?;

        let src_view = ImageRef::new(width.get(), height.get(), src.as_raw(), PixelType::U8)
            .map_err(|e| format!("创建源 Alpha 视图失败: {e}"))?;

        let mut dst_view = FrImage::new(dst_width.get(), dst_height.get(), PixelType::U8);
        let mut resizer = Resizer::new();
        let options = ResizeOptions::new().resize_alg(ResizeAlg::Convolution(FilterType::CatmullRom));

        resizer
            .resize(&src_view, &mut dst_view, &options)
            .map_err(|e| format!("Alpha Bicubic 重采样失败: {e}"))?;

        ImageBuffer::from_raw(dst_w, dst_h, dst_view.into_vec())
            .ok_or_else(|| "构造 GrayImage 输出缓冲区失败".to_string())
    }

    pub fn finalize_and_save(
        canvas_4x: RgbImage,
        alpha_channel: Option<GrayImage>,
        target_w: u32,
        target_h: u32,
        output_path: &Path,
    ) -> Result<(), String> {
        let final_rgb = Self::resize_rgb(&canvas_4x, target_w, target_h)?;

        if let Some(alpha) = alpha_channel {
            let final_alpha = Self::resize_alpha(&alpha, target_w, target_h)?;
            let mut final_rgba = RgbaImage::new(target_w, target_h);

            for y in 0..target_h {
                for x in 0..target_w {
                    let rgb_p = final_rgb.get_pixel(x, y);
                    let a_p = final_alpha.get_pixel(x, y);
                    final_rgba.put_pixel(x, y, Rgba([rgb_p[0], rgb_p[1], rgb_p[2], a_p[0]]));
                }
            }

            final_rgba
                .save(output_path)
                .map_err(|e| format!("保存 RGBA 图像失败: {e} ({:?})", output_path))?;
        } else {
            final_rgb
                .save(output_path)
                .map_err(|e| format!("保存 RGB 图像失败: {e} ({:?})", output_path))?;
        }

        Ok(())
    }
}
</file>

<file path="src-tauri/crates/services/service-upscale/src/tiling.rs">
// 🛡️ 8K 视觉超分 - 零接缝智能动态切块引擎 (tiling.rs)
// 100% 外科手术式直译自 upscale_worker.py / upscale_daemon.py

use serde::{Deserialize, Serialize};

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct TileInfo {
    pub x: u32,
    pub y: u32,
    pub w: u32,
    pub h: u32,
    pub pad_left: u32,
    pub pad_top: u32,
    pub pad_right: u32,
    pub pad_bottom: u32,
}

impl TileInfo {
    /// 计算包含 Padding 的输入图像裁剪区域: (crop_x, crop_y, crop_w, crop_h)
    #[inline]
    pub fn crop_rect(&self) -> (u32, u32, u32, u32) {
        let crop_x = self.x - self.pad_left;
        let crop_y = self.y - self.pad_top;
        let crop_w = self.w + self.pad_left + self.pad_right;
        let crop_h = self.h + self.pad_top + self.pad_bottom;
        (crop_x, crop_y, crop_w, crop_h)
    }

    /// 计算模型放大后的内部有效截取区域 (剔除 Padding 伪影): (valid_x, valid_y, valid_w, valid_h)
    #[inline]
    pub fn valid_scaled_rect(&self, model_scale: u32) -> (u32, u32, u32, u32) {
        let valid_x = self.pad_left * model_scale;
        let valid_y = self.pad_top * model_scale;
        let valid_w = self.w * model_scale;
        let valid_h = self.h * model_scale;
        (valid_x, valid_y, valid_w, valid_h)
    }

    /// 计算在全局 4x 目标画布上的贴图起始坐标: (paste_x, paste_y)
    #[inline]
    pub fn canvas_paste_pos(&self, model_scale: u32) -> (u32, u32) {
        (self.x * model_scale, self.y * model_scale)
    }
}

/// 智能网格切块计算器
/// 1:1 对齐 Python 原版 compute_grid 算法
pub fn compute_grid(img_w: u32, img_h: u32, tile_size: u32, tile_pad: u32) -> Vec<TileInfo> {
    let mut tiles = Vec::new();
    let mut y = 0;

    while y < img_h {
        let h = tile_size.min(img_h - y);
        let mut x = 0;

        while x < img_w {
            let w = tile_size.min(img_w - x);
            let pad_left = tile_pad.min(x);
            let pad_top = tile_pad.min(y);
            let pad_right = tile_pad.min(img_w.saturating_sub(x + w));
            let pad_bottom = tile_pad.min(img_h.saturating_sub(y + h));

            tiles.push(TileInfo {
                x,
                y,
                w,
                h,
                pad_left,
                pad_top,
                pad_right,
                pad_bottom,
            });

            x += tile_size;
        }

        y += tile_size;
    }

    tiles
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_compute_grid_basic() {
        // 测试 500x500 图像在 tile_size=256, pad=10 时的切块分布 (应为 2x2 = 4 块)
        let tiles = compute_grid(500, 500, 256, 10);
        assert_eq!(tiles.len(), 4);

        // 第 1 块 (左上角)
        let t0 = &tiles[0];
        assert_eq!(t0.x, 0);
        assert_eq!(t0.y, 0);
        assert_eq!(t0.w, 256);
        assert_eq!(t0.h, 256);
        assert_eq!(t0.pad_left, 0);
        assert_eq!(t0.pad_top, 0);
        assert_eq!(t0.pad_right, 10);
        assert_eq!(t0.pad_bottom, 10);
        assert_eq!(t0.crop_rect(), (0, 0, 266, 266));
        assert_eq!(t0.valid_scaled_rect(4), (0, 0, 1024, 1024));
        assert_eq!(t0.canvas_paste_pos(4), (0, 0));

        // 第 4 块 (右下角尾块: 244x244)
        let t3 = &tiles[3];
        assert_eq!(t3.x, 256);
        assert_eq!(t3.y, 256);
        assert_eq!(t3.w, 244);
        assert_eq!(t3.h, 244);
        assert_eq!(t3.pad_left, 10);
        assert_eq!(t3.pad_top, 10);
        assert_eq!(t3.pad_right, 0);
        assert_eq!(t3.pad_bottom, 0);
        assert_eq!(t3.crop_rect(), (246, 246, 254, 254));
        assert_eq!(t3.valid_scaled_rect(4), (40, 40, 976, 976));
        assert_eq!(t3.canvas_paste_pos(4), (1024, 1024));
    }

    #[test]
    fn test_small_image_no_split() {
        // 小于 tile_size 的图像不分块
        let tiles = compute_grid(100, 80, 256, 10);
        assert_eq!(tiles.len(), 1);
        let t = &tiles[0];
        assert_eq!(t.w, 100);
        assert_eq!(t.h, 80);
        assert_eq!(t.pad_left, 0);
        assert_eq!(t.pad_top, 0);
        assert_eq!(t.pad_right, 0);
        assert_eq!(t.pad_bottom, 0);
    }
}
