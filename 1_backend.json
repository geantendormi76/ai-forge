{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "showLineNumbers": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "includeFullDirectoryStructure": false,
    "instructionFilePath": "HANDOFF_BACKEND.md"
  },
  "include": [
    "HANDOFF_BACKEND.md",
    "src-tauri/Cargo.toml",
    "src-tauri/tauri.conf.json",
    "src-tauri/capabilities/**",
    "src-tauri/src/**",
    "src-tauri/crates/core-ipc/**",
    "src-tauri/crates/services/**",
    "src-tauri/crates/core-security/**",
    "src-tauri/crates/core-models-download/**",
    "src-tauri/crates/shared-contracts/**",
    "src-tauri/crates/tools/**",
    "deploy/cloudflare/auth_worker.js",
    "AI-Forge 视频字幕工具 UI & 架构全景蓝图.md",

    "package.json",
    "vite.config.ts",
    "postcss.config.js",
    "tailwind.config.js",
    "index.html",
    "src/**"

  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "src-tauri/target/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "models/**",
      "test/fixtures/**",
      "dist/**"
    ]
  }
}
