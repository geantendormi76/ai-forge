{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "紫电AI",
  "version": "0.1.19",
  "identifier": "com.zhz.zidian-ai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "紫电 AI 桌面工坊",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "bin/ffmpeg"
    ],
    "resources": {
      "../bin/pdfium.dll": "pdfium.dll",
      "../bin/cuda12/onnxruntime.dll": "onnxruntime.dll"
    },
    "publisher": "ZiDianAI",
    "shortDescription": "紫电 AI 桌面工坊 - 端侧全能 AI 生产力工具箱",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://assets.geantendormi.top/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBN0M1REY2QUExMEU3NEEKUldSSzV4Q3E5bDE4S2tlMnlJRFBZcWZLSFlKUUpaYWtwd1VDbE1RVUx2Z2pyZGFFUWkya1ZtT2IK"
    }
  }
}