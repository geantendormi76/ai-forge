{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 10000000
  },
  "output": {
    "filePath": "repomix-output-UI.xml",
    "style": "xml",
    "parsableStyle": true,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 10,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 50
    },
    // 🌟 SOTA 细粒度分级：前端源码 100% 全量，后端契约智能签名压缩
    "patterns": [
      { "pattern": "HANDOFF_UI.md", "compress": false },
      { "pattern": "src/views/**", "compress": false },
      { "pattern": "src/components/**", "compress": false },
      { "pattern": "src/store/**", "compress": false },
      { "pattern": "src/composables/**", "compress": false },
      { "pattern": "src/bindings/**", "compress": false },
      { "pattern": "src-tauri/src/lib.rs", "compress": false },
      { "pattern": "src-tauri/crates/shared-contracts/**", "compress": true }
    ]
  },
  "include": [
    // =========================================================
    // 🎨 1. [前端全景 UI 资产] 页面、组件、状态树、动效与样式
    // =========================================================
    "HANDOFF_UI.md",
    "package.json",
    "vite.config.ts",
    "postcss.config.js",
    "tailwind.config.js",
    "index.html",
    "src/App.vue",
    "src/main.ts",
    "src/style.css",
    "src/vite-env.d.ts",
    "src/views/**",
    "src/components/**",
    "src/composables/**",
    "src/store/**",
    "src/locales/**",
    "src/assets/**",

    // =========================================================
    // 🛡️ 2. [端到端契约中枢] 前后端强类型绑定与 Tauri IPC Commands
    // =========================================================
    "src/bindings.ts",
    "src/bindings/**",
    "src-tauri/src/lib.rs",
    "src-tauri/tauri.conf.json",
    "src-tauri/capabilities/**",
    "src-tauri/crates/shared-contracts/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "src-tauri/target/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/*.onnx",
      "**/*.gguf",
      "**/*.bin",
      "**/*.pdiparams",
      "**/*.pdmodel",
      "**/*.pdf",
      "**/*.dll",
      "**/*.exe",
      "test/**",
      "data/**",
      "**/*.sqlite3*",
      "dist/**",
      "deploy/website/**",
      "src_backup_before_migration/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
