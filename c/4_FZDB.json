{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 10000000
  },
  "output": {
    "filePath": "repomix-output-FZDB.xml",
    "style": "xml",
    "parsableStyle": true,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 10,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 50
    },
    "patterns": [
      { "pattern": "HANDOFF_FZDB.md", "compress": false },
      { "pattern": "RPA_PACKAGING_BLUEPRINT.md", "compress": false },
      { "pattern": "src-tauri/tauri.conf.json", "compress": false },
      { "pattern": "src-tauri/build.rs", "compress": false },
      { "pattern": "src-tauri/Cargo.toml", "compress": false },
      { "pattern": "src-tauri/capabilities/**", "compress": false },
      { "pattern": "src-tauri/src/lib.rs", "compress": false },
      { "pattern": "src-tauri/src/main.rs", "compress": false },
      { "pattern": "package.json", "compress": false },
      { "pattern": ".cargo/config.toml", "compress": false },
      { "pattern": "src-tauri/.cargo/config.toml", "compress": false }
    ]
  },
  "include": [
    "HANDOFF_FZDB.md",
    "RPA_PACKAGING_BLUEPRINT.md",
    ".cargo/**",
    "src-tauri/.cargo/**",
    "src-tauri/Cargo.toml",
    "src-tauri/tauri.conf.json",
    "src-tauri/build.rs",
    "src-tauri/capabilities/**",
    "src-tauri/src/**",
    "src-tauri/crates/**/Cargo.toml",
    "src-tauri/crates/**/src/lib.rs",
    "src-tauri/crates/core-security/**",
    "src-tauri/crates/core-models-download/**",
    "package.json",
    "vite.config.ts",
    "index.html",
    "src/App.vue",
    "src/main.ts",
    "src/style.css",
    "src/bindings.ts",
    "src/bindings/**",
    "src/store/**",
    "src/composables/**",
    "src/components/layout/Sidebar.vue",
    "src/components/layout/ToolWorkbenchLayout.vue",
    "src/views/HomeView.vue"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "src-tauri/target/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/*.onnx",
      "**/*.gguf",
      "**/*.bin",
      "**/*.pdiparams",
      "**/*.pdmodel",
      "**/*.pdf",
      "**/*.dll",
      "**/*.exe",
      "test/**",
      "data/**",
      "**/*.sqlite3*",
      "dist/**",
      "deploy/website/**",
      "src_backup_before_migration/**",
      "src-tauri/crates/services/**/src/*",
      "!src-tauri/crates/services/**/src/lib.rs"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
