{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 10000000
  },
  "output": {
    "filePath": "c/repomix-output-TOOL.xml",
    "style": "xml",
    "parsableStyle": true,
    "compress": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 10,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 50
    },
    "patterns": [
      { "pattern": "c/HANDOFF_TOOL.md", "compress": false },
      { "pattern": "src-tauri/tauri.conf.json", "compress": false },
      { "pattern": "src-tauri/Cargo.toml", "compress": false },
      { "pattern": "src-tauri/src/**", "compress": false },
      { "pattern": "src/views/**", "compress": false },
      { "pattern": "src-tauri/crates/core-*/**", "compress": true }
    ]
  },
  "include": [
    // =========================================================
    // 🏛️ 1. [公共常驻基座] 核心配置、UI 框架、通用底座与契约
    // =========================================================
    "c/HANDOFF_TOOL.md",
    ".cargo/**",
    "src-tauri/.cargo/**",
    "src-tauri/Cargo.toml",
    "src-tauri/tauri.conf.json",
    "src-tauri/capabilities/**",
    "src-tauri/src/**",
    "deploy/cloudflare/auth_worker.js",
    "src/bindings.ts",
    "src/bindings/**",
    "src/assets/**",
    "package.json",
    "vite.config.ts",
    "index.html",
    "src/App.vue",
    "src/main.ts",
    "src/style.css",
    "src/composables/**",
    "src/store/**",
    "src/components/layout/**",
    "src/views/HomeView.vue",
    "src-tauri/crates/core-models-download/**",
    "src-tauri/crates/core-security/**",
    "src-tauri/crates/shared-contracts/**",
    "src-tauri/crates/core-onnx-infer/**",

    // =========================================================
    // 📄 2. [PDF 智能解析全套：前端 + 工具层 + 6大底层 Services]
    // =========================================================
    // "src/views/PdfParseView.vue",
    // "src-tauri/crates/tools/pdf-parse/**",
    // "src-tauri/crates/services/service-pdfium/**",
    // "src-tauri/crates/services/service-doc-parse/**",
    // "src-tauri/crates/services/service-layout/**",
    // "src-tauri/crates/services/service-ocr/**",
    // "src-tauri/crates/services/service-formula/**",
    // "src-tauri/crates/services/service-table/**"

    // =========================================================
    // 🔍 3. [4K/8K 图像超分全套：前端 + 工具层 + 底层 Service]
    // =========================================================
    // "src/views/Upscale48kView.vue",
    // "src-tauri/crates/tools/upscale-48k/**",
    // "src-tauri/crates/services/service-upscale/**"

    // =========================================================
    // 🎬 4. [视频字幕生成全套：前端 + 工具层 + 2大底层 Services]
    // =========================================================
    // "src/views/VideoSubtitleView.vue",
    // "src-tauri/crates/tools/video-subtitle/**",
    // "src-tauri/crates/services/service-asr/**",
    "src-tauri/crates/services/service-translation/**"

    // =========================================================
    // ⚡ 5. [全能格式转换全套：前端 + 工具层 + 底层 Service]
    // =========================================================
    // "src/views/FormatConverterView.vue",
    // "src-tauri/crates/tools/format-converter/**",
    // "src-tauri/crates/services/service-converter/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "src-tauri/target/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/*.onnx",
      "**/*.gguf",
      "**/*.bin",
      "**/*.pdiparams",
      "**/*.pdmodel",
      "**/*.pdf",
      "**/*.dll",
      "**/*.exe",
      "test/**",
      "data/**",
      "**/*.sqlite3*",
      "dist/**",
      "deploy/website/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
